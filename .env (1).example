# Renomme ce fichier en .env et remplis les vraies valeurs.
# .env est gitignored, ne sera JAMAIS commit.

# ManyReach API key (Settings → API dans ManyReach)
MANYREACH_API_KEY=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Optionnel : limiter le bot à des campagnes spécifiques (comma-separated IDs).
# Vide = toutes les campagnes.
MANYREACH_CAMPAIGN_FILTER=

# Seuil de confidence en dessous duquel on ne fait JAMAIS d'auto-send (review obligatoire)
MIN_AUTOSEND_CONFIDENCE=0.92

# Email pour notifications d'erreur (Phase 2)
NOTIFY_EMAIL=
